DATABASE_PROVIDER=sqlite
DATABASE_PATH=partscout.db
# Set this only for Supabase/PostgreSQL deployments; never expose it via VITE_*.
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@<host>:5432/postgres
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# Keep fixture mode until the NVIDIA extractor adapter passes its tests.
SEARCH_PROVIDER=fixture
FIXTURE_SCENARIO=success
MAX_ACTIVE_SEARCHES=100
TINYFISH_API_KEY=<backend-only-tinyfish-api-key>
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai
LLM_PROVIDER=fixture
NVIDIA_API_KEY=<backend-only-nvidia-api-key>
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=<supported-nvidia-model>
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175
